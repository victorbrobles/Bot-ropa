# Proveedor del tiempo: "open_meteo" (real) o "demo" (datos sintéticos, sin red)
WEATHER_PROVIDER=open_meteo
# Minutos que se cachea una previsión por zona
WEATHER_CACHE_MINUTES=30

# Mi armario (todo gratuito: no hace falta ninguna clave)
# Enlaces de producto que cada usuario puede leer al día
LINK_READS_DAILY_LIMIT=60
DATABASE_PATH=data/vestia.db
PHOTOS_DIR=data/photos
# En producción con HTTPS:
SECURE_COOKIES=false
